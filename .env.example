# SQLite (default) or Postgres
# DATABASE_URL=sqlite:///./rag_eval.db
# DATABASE_URL=postgresql+psycopg://rag:rag@localhost:5432/rag_eval

# Required when rag-eval serve binds a non-loopback address (e.g. 0.0.0.0 in Docker)
# RAG_EVAL_API_KEY=change-me

RAG_EVAL_HOST=127.0.0.1
RAG_EVAL_PORT=8000

# RAGAS judge (OpenAI-compatible). Only needed for --evaluator ragas
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
